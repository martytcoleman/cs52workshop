# Vercel AI Gateway (on Vercel deployments, OIDC auth is automatic and this can be left blank)
AI_GATEWAY_API_KEY=

# Langfuse project keys (cloud.langfuse.com -> Settings -> API keys)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# The two blind-test arms. Pick real IDs from https://vercel.com/ai-gateway/models
MODEL_A=google/gemini-3.8-flash
MODEL_B=anthropic/claude-sonnet-5.5
# Optional: comma-separated fallback models if an arm's model is down
MODEL_FALLBACKS=

# Set to 1 to rehearse with no keys at all (fake model)
MOCK_MODELS=
# Set to 1 after class to shut the endpoint
KILL_SWITCH=
